{
  "name": "sf-qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI automation framework for Salesforce CRM (GovTech QA Assessment)",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --project=chromium --project=webkit tests/smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test tests/auth",
    "test:leads": "playwright test tests/leads",
    "test:conversion": "playwright test tests/conversion",
    "report": "playwright show-report playwright-report",
    "codegen": "playwright codegen https://login.salesforce.com",
    "prepare-session": "ts-node global-setup.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "imapflow": "^1.7.1",
    "mailparser": "^3.9.15"
  }
}
